# 必填：CoinMarketCap Pro API Key。市值数据仅从 CoinMarketCap 获取。
COINMARKETCAP_API_KEY=

# 必填：企业微信群机器人 Webhook。未配置时页面会明确显示“企业微信提醒未启用”。
WECOM_ROBOT_WEBHOOK_URL=

# 数据刷新间隔（秒），默认 120。
REFRESH_SECONDS=120

# CoinMarketCap 市值刷新间隔（秒），默认 600；OI 仍按 REFRESH_SECONDS 刷新。
CMC_REFRESH_SECONDS=600

# Optional fixed CoinMarketCap mappings. Format: BTC:1,ETH:1027
CMC_ID_OVERRIDES=

# 快照保留天数和最小可用磁盘空间（GB）。空间不足时仅保留最新快照。
SNAPSHOT_RETENTION_DAYS=30
MIN_FREE_DISK_GB=2

# 日志单文件上限（MB）和轮转备份数量。
LOG_MAX_MB=50
LOG_BACKUP_COUNT=5
